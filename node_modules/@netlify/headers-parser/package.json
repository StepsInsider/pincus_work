{
  "name": "@netlify/headers-parser",
  "version": "10.1.1",
  "description": "Parses Netlify headers into a JavaScript object representation",
  "type": "module",
  "exports": "./lib/index.js",
  "main": "./lib/index.js",
  "types": "./lib/index.d.js",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "prebuild": "rm -rf lib",
