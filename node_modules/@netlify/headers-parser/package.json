  "dependencies": {
    "escape-string-regexp": "^5.0.0",
    "smol-toml": "^1.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/netlify/build.git",
    "directory": "packages/headers-parser"
  },
  "bugs": {
    "url": "https://github.com/netlify/build/issues"
  },
